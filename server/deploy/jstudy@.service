# /etc/systemd/system/jstudy@.service  (instances: jstudy@prod, jstudy@staging)
[Unit]
Description=Japanese Study API (%i)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=jstudy
Group=jstudy
WorkingDirectory=/opt/jstudy/app-%i
EnvironmentFile=/etc/jstudy/%i.env
ExecStart=/opt/jstudy/venv/bin/uvicorn jstudy.main:app --host 127.0.0.1 --port ${PORT} --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header --no-access-log
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
MemoryHigh=256M
MemoryMax=384M
CPUQuota=100%
TasksMax=64

[Install]
WantedBy=multi-user.target
